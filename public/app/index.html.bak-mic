<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Word to Word</title>
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="icons/icon-192.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Word to Word">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#1f4fd1" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0f151d" media="(prefers-color-scheme: dark)">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Atkinson+Hyperlegible:wght@400;700&family=JetBrains+Mono:wght@500&display=swap">
<style>
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}

/* Layout: una ficha de estudio grande al centro (la sesión del día), panel lateral con progreso y pronóstico; en móvil se apilan. */
:root{
  --bg:#e9eef3; --card:#fbfcfd; --ink:#16212e; --muted:#5b6878; --line:#cdd7e2;
  --accent:#1f4fd1; --accent-ink:#ffffff; --hl:#ffe45c; --hl-ink:#2a2300;
  --good:#1e8a55; --warn:#b7791f; --bad:#c43c3c; --rule:#b9cbe6;
  --display:"Bricolage Grotesque",ui-sans-serif,system-ui,sans-serif;
  --body:"Atkinson Hyperlegible",ui-sans-serif,system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0f151d; --card:#17202b; --ink:#e6edf5; --muted:#93a2b4; --line:#2a3646;
  --accent:#7aa2ff; --accent-ink:#0b1220; --hl:#e8cf3f; --hl-ink:#1e1900;
  --good:#4cc68a; --warn:#e2a94a; --bad:#ef7a7a; --rule:#25344a; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0f151d; --card:#17202b; --ink:#e6edf5; --muted:#93a2b4; --line:#2a3646;
  --accent:#7aa2ff; --accent-ink:#0b1220; --hl:#e8cf3f; --hl-ink:#1e1900;
  --good:#4cc68a; --warn:#e2a94a; --bad:#ef7a7a; --rule:#25344a; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.5;
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 40px}
.wrap{max-width:1040px;margin:0 auto;display:grid;gap:20px}
header{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:12px}
h1{font-family:var(--display);font-weight:800;font-size:clamp(28px,5vw,40px);margin:0;letter-spacing:-.02em;line-height:1}
h1 span{background:var(--hl);color:var(--hl-ink);padding:0 .15em}
.sub{color:var(--muted);margin:6px 0 0}
.daypill{font-family:var(--mono);font-size:13px;border:1px solid var(--line);border-radius:999px;padding:6px 12px;background:var(--card)}
.grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:20px;align-items:start}
@media (max-width:820px){.grid{grid-template-columns:minmax(0,1fr)}}
.queue{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:14px;color:var(--muted)}
.chip{font-family:var(--mono);font-size:12px;padding:3px 9px;border-radius:999px;border:1px solid var(--line);background:var(--card);color:var(--ink)}
.chip.new{border-color:var(--accent);color:var(--accent)}
.chip.rev{border-color:var(--warn);color:var(--warn)}
/* la ficha: renglones de tarjeta índice */
.card{background:var(--card);border:1px solid var(--line);border-radius:6px;box-shadow:0 10px 30px -18px rgba(10,30,60,.45);overflow:hidden}
.card-top{height:10px;background:var(--bad);opacity:.55}
.card-body{padding:22px clamp(16px,4vw,32px) 26px;display:grid;gap:18px;
  background-image:repeating-linear-gradient(to bottom,transparent 0 31px,var(--rule) 31px 32px);background-position:0 8px}
.kind{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.word-row{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.word{font-family:var(--display);font-weight:700;font-size:clamp(44px,9vw,72px);line-height:1;letter-spacing:-.02em;margin:0;overflow-wrap:anywhere}
.tr{font-size:22px;font-weight:700;margin:0}
.ex{margin:0;font-size:17px}
.ex em{font-style:normal;background:var(--hl);color:var(--hl-ink);padding:0 3px}
.ex-es{color:var(--muted);font-size:14px;margin:2px 0 0}
button{font:inherit;cursor:pointer;border-radius:6px;border:1px solid var(--line);background:var(--card);color:var(--ink);padding:9px 14px;transition:transform .08s,background .15s}
button:hover{background:var(--bg)}
button:active{transform:translateY(1px)}
button:focus-visible,textarea:focus-visible,input:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
button.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:700}
button.primary:hover{filter:brightness(1.08)}
button[disabled]{opacity:.5;cursor:not-allowed}
.icon{display:inline-flex;align-items:center;gap:8px}
.icon svg{width:18px;height:18px}
.round{width:46px;height:46px;border-radius:50%;padding:0;display:inline-flex;align-items:center;justify-content:center}
.round svg{width:22px;height:22px}
.section{display:grid;gap:10px;background:var(--card);border:1px dashed var(--line);border-radius:6px;padding:14px}
.section h3{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin:0;color:var(--muted);font-weight:500}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.heard{font-size:15px;min-height:1.5em}
.tok{display:inline-block;padding:1px 6px;border-radius:4px;margin:2px 3px 2px 0;font-weight:700}
.tok.ok{background:color-mix(in srgb,var(--good) 18%,transparent);color:var(--good)}
.tok.miss{background:color-mix(in srgb,var(--bad) 18%,transparent);color:var(--bad);text-decoration:underline wavy}
.score{font-family:var(--mono);font-weight:500}
textarea{width:100%;min-height:76px;resize:vertical;font:inherit;padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink)}
.sugg{display:grid;gap:6px}
.sugg button{text-align:left;font-size:14px}
.grades{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
@media (max-width:480px){.grades{grid-template-columns:repeat(2,minmax(0,1fr))}}
.grades button{display:grid;gap:2px;padding:10px 6px;text-align:center}
.grades small{font-family:var(--mono);font-size:11px;color:var(--muted)}
.g-again{border-color:var(--bad)!important;color:var(--bad)}
.g-hard{border-color:var(--warn)!important;color:var(--warn)}
.g-good{border-color:var(--good)!important;color:var(--good)}
.g-easy{border-color:var(--accent)!important;color:var(--accent)}
.hint{color:var(--muted);font-size:14px;margin:0}
.note{font-size:14px;color:var(--muted);margin:0}
.warnbox{font-size:14px;border-left:3px solid var(--warn);padding:6px 10px;background:color-mix(in srgb,var(--warn) 10%,transparent);margin:0}
.done{text-align:center;padding:40px 20px;display:grid;gap:10px;justify-items:center}
.done h2{font-family:var(--display);font-size:32px;margin:0}
aside{display:grid;gap:16px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:16px;display:grid;gap:12px}
.panel h2{font-family:var(--mono);font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin:0;color:var(--muted);font-weight:500}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.stat b{display:block;font-family:var(--display);font-size:28px;line-height:1.1;font-variant-numeric:tabular-nums}
.stat span{font-size:12px;color:var(--muted)}
.fc{display:grid;gap:5px}
.fc-row{display:grid;grid-template-columns:62px minmax(0,1fr) 28px;gap:8px;align-items:center;font-size:13px}
.fc-row .lbl{color:var(--muted);font-family:var(--mono);font-size:12px}
.fc-bar{height:10px;background:var(--bg);border-radius:3px;overflow:hidden}
.fc-bar i{display:block;height:100%;background:var(--warn)}
.fc-row .n{font-family:var(--mono);font-variant-numeric:tabular-nums;text-align:right}
label.inl{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:14px}
input[type=number]{width:72px;font:inherit;padding:6px 8px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink)}
.confirm{display:grid;gap:8px;border:1px solid var(--bad);border-radius:6px;padding:10px;font-size:14px}
.sync{font-size:12px;color:var(--muted);font-family:var(--mono)}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

/* ===== Aviso de instalación (iPhone / Android) ===== */
.install{position:fixed;left:0;right:0;bottom:0;z-index:50;background:var(--card);border-top:1px solid var(--line);box-shadow:0 -10px 30px -18px rgba(10,30,60,.45);
  padding-top:14px;padding-bottom:calc(14px + env(safe-area-inset-bottom,0px));padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.install-in{max-width:620px;margin:0 auto;display:grid;grid-template-columns:52px minmax(0,1fr);gap:12px;align-items:start}
.install img{width:52px;height:52px;border-radius:12px}
.install h2{font-family:var(--display);font-size:18px;margin:0 0 2px}
.install ol{margin:6px 0 10px;padding-left:20px;font-size:15px;display:grid;gap:4px}
.install .sh{display:inline-flex;vertical-align:-4px;color:var(--accent)}
.install .sh svg{width:20px;height:20px}
.install .acts{display:flex;gap:8px;flex-wrap:wrap}
.install .arrow{position:absolute;bottom:calc(2px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);color:var(--accent);font-size:22px;line-height:1;animation:bob 1.2s infinite}
@keyframes bob{50%{transform:translate(-50%,4px)}}
body.has-install{padding-bottom:230px}
</style>
</head><body>
<style>
.tabs{display:flex;gap:6px;border-bottom:1px solid var(--line)}
.tabs button{border:none;border-bottom:3px solid transparent;border-radius:0;background:none;padding:8px 12px;font-weight:700;color:var(--muted)}
.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
.auth{max-width:420px;margin:40px auto 0;display:grid;gap:12px}
.auth input{width:100%;font:inherit;padding:10px;border:1px solid var(--line);border-radius:6px;background:var(--bg);color:var(--ink)}
.auth label{display:grid;gap:4px;font-size:14px}
.err{color:var(--bad);font-size:14px;margin:0;min-height:1.2em}
.scores{display:flex;flex-wrap:wrap;gap:8px}
.scores span{font-family:var(--mono);font-size:12px;border:1px solid var(--line);border-radius:999px;padding:2px 8px}
.ph{font-family:var(--mono);font-size:13px;margin-left:2px}
.ph i{font-style:normal;padding:0 1px}
.ph i.bad{color:var(--bad);text-decoration:underline}
.chat{display:grid;gap:12px}
.msgs{display:grid;gap:10px;max-height:420px;overflow-y:auto;padding:4px}
.msg{max-width:85%;padding:10px 12px;border-radius:10px;line-height:1.45}
.msg.me{justify-self:end;background:var(--accent);color:var(--accent-ink)}
.msg.ai{justify-self:start;background:var(--bg);border:1px solid var(--line)}
.fb{font-size:13px;color:var(--muted);margin:6px 0 0;border-top:1px dashed var(--line);padding-top:6px}
.compose{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:8px;align-items:end}
.compose textarea{min-height:52px}
.chip.used{background:var(--good);border-color:var(--good);color:var(--card)}
.rec{animation:pulse 1s infinite}
@keyframes pulse{50%{opacity:.5}}
.weak{display:flex;flex-wrap:wrap;gap:6px}
</style>

<div class="wrap">
  <header>
    <div>
      <h1>Word to <span>Word</span></h1>
      <p class="sub">Palabras nuevas cada día, repasos cuando tocan, y tu voz en cada ficha.</p>
    </div>
    <div class="row"><div class="daypill" id="daypill">Cargando…</div><button type="button" id="logoutBtn" hidden>Salir</button></div>
  </header>

  <section id="authView" hidden>
    <form class="auth card" id="authForm"><div class="card-top"></div><div class="card-body">
      <h2 class="tr" id="authTitle">Entrar</h2>
      <label id="nameWrap" hidden for="aName">Nombre<input id="aName" autocomplete="name"></label>
      <label for="aEmail">Correo<input id="aEmail" type="email" required autocomplete="email"></label>
      <label for="aPass">Contraseña<input id="aPass" type="password" required minlength="8" autocomplete="current-password"></label>
      <p class="err" id="authErr"></p>
      <div class="row"><button class="primary" type="submit" id="authSubmit">Entrar</button><button type="button" id="authSwitch">Crear cuenta</button></div>
    </div></form>
  </section>

  <section id="appView" hidden>
    <div class="grid">
      <div style="display:grid;gap:14px;min-width:0">
        <div class="tabs" role="tablist">
          <button type="button" role="tab" id="tabCards" aria-selected="true">Fichas</button>
          <button type="button" role="tab" id="tabChat" aria-selected="false">Conversación</button>
        </div>
        <div class="queue" id="queue"></div>
        <main id="main" aria-live="polite"></main>
        <section id="chatView" hidden class="card"><div class="card-top"></div><div class="card-body chat">
          <div class="kind"><span>Habla usando tus palabras de hoy</span><span id="chatMode"></span></div>
          <div class="row" id="targets"></div>
          <div class="msgs" id="msgs"></div>
          <div class="compose">
            <textarea id="chatIn" placeholder="Escribe o dicta tu respuesta en inglés…"></textarea>
            <button type="button" class="round" id="dictBtn" aria-label="Dictar">MIC</button>
            <button type="button" class="primary" id="sendBtn">Enviar</button>
          </div>
          <div class="row"><button type="button" id="chatReset">Nueva conversación</button><label class="inl" for="autoSpeak"><input type="checkbox" id="autoSpeak" checked> Leer respuestas en voz alta</label></div>
        </div></section>
      </div>
      <aside>
        <div class="panel">
          <h2>Tu progreso</h2>
          <div class="stats">
            <div class="stat"><b id="sLearned">0</b><span>aprendidas</span></div>
            <div class="stat"><b id="sMastered">0</b><span>dominadas</span></div>
            <div class="stat"><b id="sStreak">0</b><span>días seguidos</span></div>
          </div>
          <p class="note" id="sLeft"></p>
        </div>
        <div class="panel">
          <h2>Repasos próximos 7 días</h2>
          <div class="fc" id="forecast"></div>
        </div>
        <div class="panel" id="weakPanel" hidden>
          <h2>Sonidos que te cuestan</h2>
          <div class="weak" id="weak"></div>
        </div>
        <div class="panel">
          <h2>Ajustes</h2>
          <label class="inl" for="dailyNew">Palabras nuevas por día <input type="number" id="dailyNew" min="1" max="50" value="10"></label>
          <button id="nextDay" type="button">Adelantar un día (para probar)</button>
          <button id="resetBtn" type="button">Reiniciar progreso</button>
          <div id="confirmBox" hidden class="confirm">
            <span>Se borra todo tu progreso. ¿Seguro?</span>
            <div class="row"><button id="resetYes" type="button" class="g-again">Sí, borrar</button><button id="resetNo" type="button">Cancelar</button></div>
          </div>
          <span class="sync" id="svc"></span>
        </div>
      </aside>
    </div>
  </section>
</div>


<div class="install" id="installBar" hidden role="dialog" aria-labelledby="installTitle">
  <div class="install-in">
    <img src="icons/apple-touch-icon.png" alt="">
    <div>
      <h2 id="installTitle">Instala Word to Word</h2>
      <div id="installBody"></div>
      <div class="acts"><button type="button" class="primary" id="installBtn" hidden>Instalar</button><button type="button" id="installLater">Ahora no</button></div>
    </div>
  </div>
  <span class="arrow" id="installArrow" hidden aria-hidden="true">&#8595;</span>
</div>

<script>
// ===== Cliente de la API =====
const API = "/api";
let token = null; try { token = localStorage.getItem("wtw_token"); } catch (e) {}
async function api(path, opts = {}) {
  const headers = Object.assign({ Accept: "application/json" }, opts.headers || {});
  if (token) headers.Authorization = "Bearer " + token;
  let body = opts.body;
  if (body && !(body instanceof FormData)) { headers["Content-Type"] = "application/json"; body = JSON.stringify(body); }
  const res = await fetch(API + path, { method: opts.method || "GET", headers, body });
  if (res.status === 401) { setToken(null); showAuth(); throw new Error("Tu sesión expiró. Entra otra vez."); }
  if (res.status === 204) return null;
  const data = await res.json().catch(() => ({}));
  if (!res.ok) {
    const msg = data.errors ? Object.values(data.errors).flat()[0] : (data.message || ("Error " + res.status));
    throw new Error(msg);
  }
  return data;
}
function setToken(t) { token = t; try { t ? localStorage.setItem("wtw_token", t) : localStorage.removeItem("wtw_token"); } catch (e) {} }

// ===== Utilidades =====
const $ = id => document.getElementById(id);
function esc(s) { return String(s ?? "").replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c])); }
function exHTML(ex) { return esc(ex).replace(/\*(.+?)\*/g, "<em>$1</em>"); }
function plain(ex) { return String(ex || "").replace(/\*/g, ""); }
function days(n) { return n === 1 ? "mañana" : "en " + n + " días"; }
const ICON_SPK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>';
const ICON_MIC = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>';
$("dictBtn").innerHTML = ICON_MIC;

// ===== Voz (TTS del navegador) =====
let voice = null;
function pickVoice() { const vs = speechSynthesis.getVoices(); voice = vs.find(v => /en-US/i.test(v.lang) && /Samantha|Google US|Aria|Jenny/i.test(v.name)) || vs.find(v => /en-US/i.test(v.lang)) || null; }
if ("speechSynthesis" in window) { pickVoice(); speechSynthesis.onvoiceschanged = pickVoice; }
function say(text, slow) { if (!("speechSynthesis" in window)) return; speechSynthesis.cancel(); const u = new SpeechSynthesisUtterance(text); u.lang = "en-US"; if (voice) u.voice = voice; u.rate = slow ? 0.6 : 0.9; speechSynthesis.speak(u); }

// ===== Grabación WAV 16 kHz (para Azure) =====
async function recordWav(maxMs = 6000, onStart) {
  const stream = await navigator.mediaDevices.getUserMedia({ audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true } });
  const ctx = new (window.AudioContext || window.webkitAudioContext)();
  if (ctx.state === "suspended") { try { await ctx.resume(); } catch (e) {} } // iPhone
  const src = ctx.createMediaStreamSource(stream);
  const proc = ctx.createScriptProcessor(4096, 1, 1);
  const chunks = []; let silentFor = 0, heard = false;
  src.connect(proc); proc.connect(ctx.destination);
  onStart && onStart();
  return new Promise(resolve => {
    const stop = () => {
      proc.disconnect(); src.disconnect(); stream.getTracks().forEach(t => t.stop());
      const rate = ctx.sampleRate; ctx.close();
      resolve(encodeWav(downsample(flatten(chunks), rate, 16000), 16000));
    };
    const timer = setTimeout(stop, maxMs);
    proc.onaudioprocess = e => {
      const d = new Float32Array(e.inputBuffer.getChannelData(0)); chunks.push(d);
      let rms = 0; for (let i = 0; i < d.length; i++) rms += d[i] * d[i]; rms = Math.sqrt(rms / d.length);
      if (rms > 0.02) { heard = true; silentFor = 0; } else if (heard) { silentFor += d.length / ctx.sampleRate; if (silentFor > 1.2) { clearTimeout(timer); stop(); } }
    };
  });
}
function flatten(cs) { const n = cs.reduce((a, c) => a + c.length, 0), out = new Float32Array(n); let o = 0; cs.forEach(c => { out.set(c, o); o += c.length; }); return out; }
function downsample(buf, from, to) { if (from === to) return buf; const r = from / to, n = Math.floor(buf.length / r), out = new Float32Array(n); for (let i = 0; i < n; i++) { const s = Math.floor(i * r), e = Math.floor((i + 1) * r); let sum = 0; for (let j = s; j < e; j++) sum += buf[j]; out[i] = sum / (e - s); } return out; }
function encodeWav(samples, rate) {
  const b = new ArrayBuffer(44 + samples.length * 2), v = new DataView(b);
  const w = (o, s) => { for (let i = 0; i < s.length; i++) v.setUint8(o + i, s.charCodeAt(i)); };
  w(0, "RIFF"); v.setUint32(4, 36 + samples.length * 2, true); w(8, "WAVE"); w(12, "fmt "); v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
  v.setUint32(24, rate, true); v.setUint32(28, rate * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true); w(36, "data"); v.setUint32(40, samples.length * 2, true);
  for (let i = 0; i < samples.length; i++) { const s = Math.max(-1, Math.min(1, samples[i])); v.setInt16(44 + i * 2, s < 0 ? s * 0x8000 : s * 0x7fff, true); }
  return new Blob([b], { type: "audio/wav" });
}

// ===== Reconocimiento del navegador (modo sin Azure y dictado) =====
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
function norm(s) { return s.toLowerCase().replace(/[’']/g, "").replace(/[^a-z0-9\s]/g, " ").split(/\s+/).filter(Boolean); }
function compare(target, heard) { const t = norm(target), pool = norm(heard); const toks = t.map(x => { const i = pool.indexOf(x); if (i > -1) { pool.splice(i, 1); return { x, ok: true }; } return { x, ok: false }; }); return { toks, pct: t.length ? Math.round(toks.filter(z => z.ok).length / t.length * 100) : 0 }; }
function browserListen() {
  return new Promise((resolve, reject) => {
    if (!SR) return reject(new Error("Este navegador no reconoce voz. Usa Google Chrome."));
    const r = new SR(); r.lang = "en-US"; r.maxAlternatives = 4; r.interimResults = false;
    r.onresult = e => resolve([...e.results[0]].map(a => a.transcript));
    r.onerror = e => reject(new Error((e.error === "service-not-allowed" || /iPhone|iPad/.test(navigator.userAgent)) && e.error !== "no-speech" ? "En el iPhone el reconocimiento del navegador no funciona. Hay que activar la evaluación en el servidor (AZURE_SPEECH_KEY)." : e.error === "not-allowed" ? "Permite el micrófono en el navegador." : e.error === "no-speech" ? "No oí nada. Habla más cerca." : "Error de voz: " + e.error));
    r.start();
  });
}

// ===== Estado =====
let cfg = { ai: false, pronunciation: false, time_travel: false };
let cards = [], revealed = false, showHint = false, stats = null;

// ===== Auth =====
let registering = false;
function showAuth() { $("authView").hidden = false; $("appView").hidden = true; $("logoutBtn").hidden = true; $("daypill").textContent = "Sin sesión"; }
$("authSwitch").onclick = () => { registering = !registering; $("nameWrap").hidden = !registering; $("authTitle").textContent = registering ? "Crear cuenta" : "Entrar"; $("authSubmit").textContent = registering ? "Crear cuenta" : "Entrar"; $("authSwitch").textContent = registering ? "Ya tengo cuenta" : "Crear cuenta"; $("authErr").textContent = ""; };
$("authForm").onsubmit = async e => {
  e.preventDefault(); $("authErr").textContent = "";
  try {
    const body = { email: $("aEmail").value, password: $("aPass").value };
    if (registering) body.name = $("aName").value || "Estudiante";
    const r = await api(registering ? "/auth/register" : "/auth/login", { method: "POST", body });
    setToken(r.token); start();
  } catch (err) { $("authErr").textContent = err.message; }
};
$("logoutBtn").onclick = async () => { try { await api("/auth/logout", { method: "POST" }); } catch (e) {} setToken(null); showAuth(); };

// ===== Carga =====
async function start() {
  $("authView").hidden = true; $("appView").hidden = false; $("logoutBtn").hidden = false;
  try { cfg = await api("/config"); } catch (e) {}
  $("svc").textContent = "IA: " + (cfg.ai ? "activa" : "sin configurar") + " · Pronunciación: " + (cfg.pronunciation ? "Azure" : "navegador");
  $("nextDay").hidden = !cfg.time_travel;
  $("chatMode").textContent = cfg.ai ? "" : "Necesita ANTHROPIC_API_KEY";
  await refresh();
}
async function refresh() {
  try {
    const [t, s] = await Promise.all([api("/today"), api("/stats")]);
    cards = t.cards; stats = s; revealed = false; showHint = false;
    $("dailyNew").value = t.daily_new;
    render(); renderSide();
  } catch (e) { $("main").innerHTML = '<p class="warnbox">' + esc(e.message) + "</p>"; }
}

// ===== Ficha =====
function speakingBlock() {
  return `<div class="section"><h3>Practica speaking ${cfg.pronunciation ? "· evaluado por Azure" : ""}</h3>
    <div class="row">
      <button type="button" class="icon" data-say="word">${ICON_MIC} Decir la palabra</button>
      <button type="button" class="icon" data-say="sentence">${ICON_MIC} Decir la frase</button>
      <button type="button" class="icon" data-slow="1">${ICON_SPK} Frase lenta</button>
    </div>
    <div class="heard" id="heard"><span class="note">Escucha primero, luego pulsa un micrófono y repite en voz alta.</span></div></div>`;
}
function aidBlock(c, nudge) {
  return `<div class="section"><h3>Tu escena AID</h3>
    ${nudge ? '<p class="warnbox">Fallaste esta palabra ' + c.fails + ' veces. Crea una escena absurda para fijarla.</p>' : ""}
    <textarea id="aid" placeholder="Ej.: suena a “…”. Imagina una acción absurda, exagerada y con detalles…">${esc(c.aid || "")}</textarea>
    <div class="row">${cfg.ai ? '<button type="button" id="suggBtn">Sugerir escenas con IA</button>' : ""}<span class="sync" id="aidState"></span></div>
    <div class="sugg" id="sugg"></div></div>`;
}
function render() {
  const nNew = cards.filter(c => c.mode === "new").length, nRev = cards.length - nNew;
  $("queue").innerHTML = `<span>Hoy te quedan:</span><span class="chip rev">${nRev} repasos</span><span class="chip new">${nNew} nuevas</span>`;
  if (stats) $("daypill").textContent = new Date(stats.today + "T12:00").toLocaleDateString("es", { weekday: "long", day: "numeric", month: "short" });
  const main = $("main"), c = cards[0];
  if (!c) {
    const tm = stats ? stats.forecast[0].count : 0;
    main.innerHTML = `<div class="card"><div class="card-top"></div><div class="card-body done">
      <h2>Sesión de hoy completa</h2>
      <p class="note">Mañana te esperan ${tm} repasos y tus palabras nuevas.</p>
      <p class="note">Ahora practica en la pestaña Conversación usando las palabras de hoy.</p>
      ${cfg.time_travel ? '<button type="button" class="primary" id="goNext">Simular mañana</button>' : ""}</div></div>`;
    if ($("goNext")) $("goNext").onclick = nextDay;
    return;
  }
  const isNew = c.mode === "new";
  const front = `<div class="kind"><span>${isNew ? "Palabra nueva" : "Repaso · nivel " + c.level}</span><span>#${c.rank} en frecuencia${c.best_pron_score != null ? " · pronunciación " + c.best_pron_score + "%" : ""}</span></div>
    <div class="word-row"><h2 class="word">${esc(c.word)}</h2><button type="button" class="round" id="spk" aria-label="Escuchar">${ICON_SPK}</button></div>`;
  let body;
  if (isNew) {
    body = `<p class="tr">${esc(c.translation)}</p><div><p class="ex">${exHTML(c.example)}</p><p class="ex-es">${esc(c.example_es)}</p></div>
      ${speakingBlock()}${aidBlock(c, false)}
      <div class="row"><button type="button" class="primary" id="learn">Ya la tengo · repasar mañana</button></div>`;
  } else if (!revealed) {
    body = `<p class="hint">¿Qué significa? Dilo en voz alta antes de ver la respuesta.</p>
      ${c.aid ? (showHint ? `<p class="warnbox">Pista AID: ${esc(c.aid)}</p>` : '<div class="row"><button type="button" id="hintBtn">Ver pista AID</button></div>') : ""}
      <div class="row"><button type="button" class="primary" id="reveal">Mostrar respuesta</button></div>`;
  } else {
    const p = c.previews || { again: 1, hard: 1, good: 3, easy: 7 };
    body = `<p class="tr">${esc(c.translation)}</p><div><p class="ex">${exHTML(c.example)}</p><p class="ex-es">${esc(c.example_es)}</p></div>
      ${speakingBlock()}${aidBlock(c, c.fails >= 2 && !c.aid)}
      <div class="grades">
        <button type="button" class="g-again" data-g="again">Olvidé<small>${days(p.again)}</small></button>
        <button type="button" class="g-hard" data-g="hard">Difícil<small>${days(p.hard)}</small></button>
        <button type="button" class="g-good" data-g="good">Bien<small>${days(p.good)}</small></button>
        <button type="button" class="g-easy" data-g="easy">Fácil<small>${days(p.easy)}</small></button>
      </div>`;
  }
  main.innerHTML = `<div class="card"><div class="card-top"></div><div class="card-body">${front}${body}</div></div>`;
  $("spk").onclick = () => say(c.word);
  if ($("learn")) $("learn").onclick = () => act(() => api(`/words/${c.id}/learn`, { method: "POST" }));
  if ($("reveal")) $("reveal").onclick = () => { revealed = true; render(); say(c.word); };
  if ($("hintBtn")) $("hintBtn").onclick = () => { showHint = true; render(); };
  if ($("aid")) { let t; $("aid").oninput = e => { c.aid = e.target.value; $("aidState").textContent = "Guardando…"; clearTimeout(t); t = setTimeout(() => api(`/words/${c.id}/aid`, { method: "PUT", body: { aid: c.aid } }).then(() => $("aidState").textContent = "Guardado").catch(err => $("aidState").textContent = err.message), 700); }; }
  if ($("suggBtn")) $("suggBtn").onclick = () => suggest(c);
  main.querySelectorAll("[data-g]").forEach(b => b.onclick = () => act(() => api(`/words/${c.id}/review`, { method: "POST", body: { grade: b.dataset.g } })));
  main.querySelectorAll("[data-say]").forEach(b => b.onclick = () => practice(c, b.dataset.say));
  main.querySelectorAll("[data-slow]").forEach(b => b.onclick = () => say(plain(c.example), true));
}
async function act(fn) {
  document.querySelectorAll("#main button").forEach(b => b.disabled = true);
  try { await fn(); cards.shift(); revealed = false; showHint = false; render(); stats = await api("/stats"); renderSide(); }
  catch (e) { $("main").insertAdjacentHTML("afterbegin", '<p class="warnbox">' + esc(e.message) + "</p>"); document.querySelectorAll("#main button").forEach(b => b.disabled = false); }
}
async function suggest(c) {
  $("sugg").innerHTML = '<p class="note">Pensando escenas absurdas…</p>';
  try {
    const r = await api(`/words/${c.id}/aid/suggest`, { method: "POST" });
    $("sugg").innerHTML = r.suggestions.map((l, i) => `<button type="button" data-pick="${i}">${esc(l)}</button>`).join("") + '<p class="hint">Toca una para usarla. Mejor aún: edítala a tu manera.</p>';
    $("sugg").querySelectorAll("[data-pick]").forEach(b => b.onclick = () => { $("aid").value = r.suggestions[+b.dataset.pick]; $("aid").dispatchEvent(new Event("input")); });
  } catch (e) { $("sugg").innerHTML = '<p class="note">' + esc(e.message) + "</p>"; }
}

// ===== Speaking =====
async function practice(c, target) {
  const ref = target === "word" ? c.word : plain(c.example), out = $("heard");
  const btns = document.querySelectorAll("[data-say]"); btns.forEach(b => b.disabled = true);
  try {
    if (cfg.pronunciation) {
      out.innerHTML = '<span class="score rec">Grabando… di:</span> <b>' + esc(ref) + "</b>";
      const wav = await recordWav(target === "word" ? 3500 : 7000);
      out.innerHTML = '<span class="note">Evaluando tu pronunciación…</span>';
      const fd = new FormData(); fd.append("target", target); fd.append("audio", wav, "voz.wav");
      const r = await api(`/words/${c.id}/pronunciation`, { method: "POST", body: fd });
      showAzure(r, out);
      if (target === "word") c.best_pron_score = Math.max(c.best_pron_score || 0, r.score);
    } else {
      out.innerHTML = '<span class="score rec">Escuchando… di:</span> <b>' + esc(ref) + "</b>";
      const alts = await browserListen(); let best = null, bt = "";
      alts.forEach(a => { const r = compare(ref, a); if (!best || r.pct > best.pct) { best = r; bt = a; } });
      verdict(out, best.pct, '<span class="note">Entendí: “' + esc(bt) + '”</span>', best.toks.map(z => `<span class="tok ${z.ok ? "ok" : "miss"}">${esc(z.x)}</span>`).join(""));
      api(`/words/${c.id}/pronunciation`, { method: "POST", body: { target, score: best.pct } }).catch(() => {});
    }
  } catch (e) { out.innerHTML = '<p class="warnbox">' + esc(e.message || "No se pudo usar el micrófono.") + "</p>"; }
  btns.forEach(b => b.disabled = false);
}
function verdict(out, pct, extra, tokens) {
  const v = pct >= 90 ? "Excelente" : pct >= 70 ? "Casi" : "Otra vez", col = pct >= 90 ? "var(--good)" : pct >= 70 ? "var(--warn)" : "var(--bad)";
  out.innerHTML = `<div class="row"><b class="score" style="color:${col}">${v} · ${pct}%</b>${extra}</div><div>${tokens}</div>` + (pct < 90 ? '<p class="hint">Lo marcado en rojo necesita práctica. Escucha el audio lento y repite.</p>' : "");
}
function showAzure(r, out) {
  const a = r.assessment;
  if (!a || a.status !== "Success") { out.innerHTML = '<p class="note">No se entendió el audio. Habla un poco más fuerte y cerca del micrófono.</p>'; return; }
  const s = a.scores;
  const toks = a.words.map(w => {
    const ok = w.error === "None" && w.accuracy >= 80;
    const ph = w.phonemes.length ? `<span class="ph">/${w.phonemes.map(p => `<i class="${p.accuracy < 60 ? "bad" : ""}" title="${p.accuracy}%">${esc(p.phoneme)}</i>`).join("")}/</span>` : "";
    const tag = w.error === "Omission" ? " (omitida)" : w.error === "Insertion" ? " (de más)" : "";
    return `<span class="tok ${ok ? "ok" : "miss"}">${esc(w.word)} ${w.accuracy}%${tag}</span>${ok ? "" : ph}`;
  }).join(" ");
  verdict(out, s.pron, `<span class="scores"><span>Precisión ${s.accuracy}</span><span>Fluidez ${s.fluency}</span><span>Completitud ${s.completeness}</span></span>`, toks);
}

// ===== Conversación =====
let history = [];
function renderChat(targets, used) {
  if (targets) $("targets").innerHTML = targets.map(t => `<span class="chip ${used && used.has(t.toLowerCase()) ? "used" : ""}">${esc(t)}</span>`).join("");
  $("msgs").innerHTML = history.map(m => `<div class="msg ${m.role === "user" ? "me" : "ai"}">${esc(m.content)}${m.feedback ? `<p class="fb">${esc(m.feedback)}</p>` : ""}</div>`).join("") || '<p class="note">Pulsa Enviar con el campo vacío para que la IA empiece.</p>';
  $("msgs").scrollTop = $("msgs").scrollHeight;
}
const usedWords = new Set();
async function sendChat() {
  if (!cfg.ai) { $("msgs").innerHTML = '<p class="warnbox">La conversación necesita ANTHROPIC_API_KEY en el servidor.</p>'; return; }
  const text = $("chatIn").value.trim();
  if (text) history.push({ role: "user", content: text });
  $("chatIn").value = ""; $("sendBtn").disabled = true; renderChat();
  try {
    const r = await api("/conversation", { method: "POST", body: { messages: history.map(({ role, content }) => ({ role, content })) } });
    const lastUser = [...history].reverse().find(m => m.role === "user");
    if (lastUser && r.feedback) lastUser.feedback = r.feedback;
    (r.used || []).forEach(w => usedWords.add(w.toLowerCase()));
    history.push({ role: "assistant", content: r.reply });
    renderChat(r.targets, usedWords);
    if ($("autoSpeak").checked) say(r.reply);
  } catch (e) { $("msgs").insertAdjacentHTML("beforeend", '<p class="warnbox">' + esc(e.message) + "</p>"); }
  $("sendBtn").disabled = false;
}
$("sendBtn").onclick = sendChat;
$("chatIn").onkeydown = e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendChat(); } };
$("chatReset").onclick = () => { history = []; usedWords.clear(); renderChat([]); };
$("dictBtn").onclick = async () => {
  $("dictBtn").classList.add("rec");
  try { const alts = await browserListen(); $("chatIn").value = ($("chatIn").value + " " + alts[0]).trim(); }
  catch (e) { $("msgs").insertAdjacentHTML("beforeend", '<p class="warnbox">' + esc(e.message) + "</p>"); }
  $("dictBtn").classList.remove("rec");
};
function showTab(chat) {
  $("tabCards").setAttribute("aria-selected", !chat); $("tabChat").setAttribute("aria-selected", chat);
  $("main").hidden = chat; $("queue").hidden = chat; $("chatView").hidden = !chat;
  if (chat) renderChat();
}
$("tabCards").onclick = () => showTab(false);
$("tabChat").onclick = () => showTab(true);

// ===== Panel lateral y ajustes =====
function renderSide() {
  if (!stats) return;
  $("sLearned").textContent = stats.learned; $("sMastered").textContent = stats.mastered; $("sStreak").textContent = stats.streak;
  $("sLeft").textContent = `${stats.total_words - stats.learned} palabras por aprender de ${stats.total_words}.`;
  const max = Math.max(1, ...stats.forecast.map(x => x.count));
  $("forecast").innerHTML = stats.forecast.map((x, i) => { const d = new Date(x.date + "T12:00"); const lbl = i === 0 ? "mañana" : d.toLocaleDateString("es", { weekday: "short", day: "numeric" }); return `<div class="fc-row"><span class="lbl">${lbl}</span><span class="fc-bar"><i style="width:${x.count / max * 100}%"></i></span><span class="n">${x.count}</span></div>`; }).join("");
  $("weakPanel").hidden = !stats.weak_sounds.length;
  $("weak").innerHTML = stats.weak_sounds.map(w => `<span class="chip" title="Último: ${esc(w.last_word)}">/${esc(w.phoneme)}/ × ${w.count}</span>`).join("");
}
$("dailyNew").onchange = async e => { try { await api("/settings", { method: "PUT", body: { daily_new: +e.target.value } }); refresh(); } catch (err) { alertSide(err.message); } };
async function nextDay() { try { await api("/debug/next-day", { method: "POST" }); refresh(); } catch (e) { alertSide(e.message); } }
$("nextDay").onclick = nextDay;
$("resetBtn").onclick = () => $("confirmBox").hidden = false;
$("resetNo").onclick = () => $("confirmBox").hidden = true;
$("resetYes").onclick = async () => { $("confirmBox").hidden = true; try { await api("/reset", { method: "POST" }); refresh(); } catch (e) { alertSide(e.message); } };
function alertSide(m) { $("svc").textContent = m; }

// ===== PWA: instalable en el iPhone =====
if ("serviceWorker" in navigator) { window.addEventListener("load", () => navigator.serviceWorker.register("sw.js").catch(() => {})); }

// ===== Aviso para instalar la app =====
(function () {
  const ua = navigator.userAgent;
  const isIOS = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
  const isAndroid = /Android/i.test(ua);
  const standalone = window.navigator.standalone === true || window.matchMedia("(display-mode: standalone)").matches;
  const inAppBrowser = /FBAN|FBAV|Instagram|Line\/|WhatsApp|GSA\//.test(ua);
  const iosOtherBrowser = isIOS && /CriOS|FxiOS|EdgiOS/.test(ua);
  const KEY = "wtw_install_later";
  let snoozed = false; try { snoozed = Date.now() < +(localStorage.getItem(KEY) || 0); } catch (e) {}
  if (standalone || snoozed || !(isIOS || isAndroid)) return;

  const bar = $("installBar"), body = $("installBody"), btn = $("installBtn");
  const SHARE = '<span class="sh" aria-label="Compartir"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M8 7l4-4 4 4"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg></span>';
  function show() { bar.hidden = false; document.body.classList.add("has-install"); }
  function hide(days) { bar.hidden = true; document.body.classList.remove("has-install"); if (days) { try { localStorage.setItem(KEY, Date.now() + days * 864e5); } catch (e) {} } }
  $("installLater").onclick = () => hide(3);

  if (isIOS) {
    if (inAppBrowser) {
      body.innerHTML = '<p class="note">Estás dentro de otra app. Abre este enlace en <b>Safari</b> para poder instalarla.</p>';
    } else {
      body.innerHTML = '<ol>' +
        '<li>Toca ' + SHARE + ' <b>Compartir</b> ' + (iosOtherBrowser ? "(arriba o en el menú)" : "en la barra de Safari") + '.</li>' +
        '<li>Elige <b>Agregar a pantalla de inicio</b>. Si no aparece, desliza la lista hacia abajo.</li>' +
        '<li>Toca <b>Agregar</b>. Ábrela siempre desde su ícono.</li></ol>';
      if (!iosOtherBrowser) $("installArrow").hidden = false;
    }
    show();
  } else {
    // Android / Chrome: el navegador permite instalar con un botón
    let deferred = null;
    window.addEventListener("beforeinstallprompt", e => {
      e.preventDefault(); deferred = e;
      body.innerHTML = '<p class="note">Agrégala a tu pantalla de inicio para abrirla como una app.</p>';
      btn.hidden = false; show();
    });
    btn.onclick = async () => { if (!deferred) return; deferred.prompt(); const r = await deferred.userChoice; deferred = null; hide(r.outcome === "accepted" ? 0 : 3); };
    window.addEventListener("appinstalled", () => hide(0));
  }
})();

// ===== Arranque =====
token ? start() : showAuth();
</script>
</body></html>
