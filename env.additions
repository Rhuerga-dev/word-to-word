# --- Word to Word: agrega esto al final de tu .env ---

# Zona horaria que define el cambio de día de estudio
VOCAB_TIMEZONE=America/New_York
VOCAB_DAILY_NEW=10
# Botón "Adelantar un día" (ponlo en false en producción)
VOCAB_ALLOW_TIME_TRAVEL=true

# Claude (escenas AID, traducciones NGSL, conversación). https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Azure AI Speech (calificación de pronunciación por sonido). Opcional:
# si lo dejas vacío, la app califica con el reconocimiento de voz de Chrome.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
